# Copy to .env. All values are optional for local use on this PC.

# Address the port is published on. Keep 127.0.0.1 until you've created the first account,
# because the first visitor to an empty installation becomes the administrator.
BIND_ADDRESS=127.0.0.1
PORT=8000

# Nightly refresh of market data (local time, 24h clock)
REFRESH_HOUR=6

# Stocks the buy-candidate screener refreshes per night. Each takes three Yahoo requests.
SCREENER_BATCH=200
TZ=Europe/Amsterdam

# Vraag Claude. The default uses Claude Code and your Claude subscription, for the first admin only.
# Set ASK_BACKEND=api and ANTHROPIC_API_KEY to pay per question instead and open it to all accounts.
# On this PC, .env sits in the OneDrive folder, so see "Vraag Claude" in the README first.
ASK_BACKEND=claude-code
ANTHROPIC_API_KEY=
ASK_MODEL=claude-opus-5-5
# Questions per user per day.
ASK_DAILY_LIMIT=50
