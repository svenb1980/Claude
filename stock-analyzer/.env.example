# Copy to .env. All values are optional for local use on this PC.

# Address the port is published on. Keep 127.0.0.1 until PORTFOLIO_PASSWORD is set.
BIND_ADDRESS=127.0.0.1
PORT=8000

# Turns on the login screen. Required before opening the tool to your network.
PORTFOLIO_PASSWORD=

# Nightly refresh of market data (local time, 24h clock)
REFRESH_HOUR=6
TZ=Europe/Amsterdam
