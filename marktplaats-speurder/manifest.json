{
  "manifest_version": 3,
  "name": "Marktplaats Speurder",
  "version": "1.0.0",
  "description": "Houdt meerdere zoekopdrachten op Marktplaats in de gaten en meldt nieuwe advertenties zodra ze online komen.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.marktplaats.nl/*",
    "https://images.marktplaats.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marktplaats Speurder",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
