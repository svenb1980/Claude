{
  "manifest_version": 3,
  "name": "Planon Verlof Goedkeurder",
  "version": "1.2.0",
  "description": "Controleert en keurt verlofaanvragen in Planon Self-Service automatisch goed (# Hours tegen From/Till) en meldt het resultaat aan Cyberdeck.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://*.claudeusercontent.com/*",
    "https://*.claude.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.planoncloud.com/case/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://*.claudeusercontent.com/*",
        "https://*.claude.site/*"
      ],
      "js": ["bridge.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
